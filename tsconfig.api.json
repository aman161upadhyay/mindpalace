{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "outDir": "dist-api",
    "rootDir": "."
  },
  "include": [
    "api/**/*.ts",
    "src/server/**/*.ts",
    "src/lib/**/*.ts",
    "src/schema.ts"
  ]
}
